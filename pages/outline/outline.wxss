page {
  background-color: #f5f7fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.outline-page {
  padding: 28rpx 32rpx 48rpx;
}

button::after {
  border: none;
}

.demo-banner {
  padding: 20rpx 24rpx;
  border: 1rpx solid #ffe0a3;
  border-radius: 16rpx;
  background-color: #fff7e6;
  color: #8a5700;
  font-size: 24rpx;
  line-height: 1.6;
}

.document-header {
  margin-top: 32rpx;
}

.document-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.document-meta {
  display: block;
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.7;
}

.source-button {
  margin: 18rpx 0 0;
  padding: 12rpx 0;
  background-color: transparent;
  color: #2563eb;
  font-size: 27rpx;
  line-height: 1.5;
  text-align: left;
}

.reading-tip {
  margin: 24rpx 0;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.group-card {
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e8edf4;
  border-radius: 18rpx;
  background-color: #ffffff;
}

.group-toggle {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 0;
  padding: 28rpx 24rpx;
  border-radius: 0;
  background-color: #ffffff;
  line-height: 1.6;
  text-align: left;
}

.group-arrow {
  flex-shrink: 0;
  margin-right: 14rpx;
  color: #64748b;
  font-size: 22rpx;
}

.group-title {
  flex: 1;
  min-width: 0;
  color: #1f2937;
  font-size: 29rpx;
  font-weight: 600;
}

.group-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #8491a3;
  font-size: 23rpx;
}

.point-list {
  padding: 0 24rpx;
}

.point-button {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 0;
  padding: 24rpx 0 24rpx 30rpx;
  border-top: 1rpx solid #eef2f6;
  border-radius: 0;
  background-color: #ffffff;
  line-height: 1.6;
  text-align: left;
  box-sizing: border-box;
}

.point-content {
  flex: 1;
  min-width: 0;
}

.point-title {
  display: block;
  color: #334155;
  font-size: 27rpx;
  word-break: break-all;
}

.point-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10rpx;
}

.point-source {
  margin-right: 16rpx;
  color: #8491a3;
  font-size: 22rpx;
}

.review-tag {
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background-color: #fff7e6;
  color: #8a5700;
  font-size: 21rpx;
}

.point-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #94a3b8;
  font-size: 38rpx;
}

.add-button {
  margin-top: 28rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  background-color: #eaf0ff;
  color: #2454b8;
  font-size: 28rpx;
  line-height: 1.5;
}

.page-footer {
  margin-top: 28rpx;
  color: #8491a3;
  font-size: 23rpx;
  line-height: 1.7;
  text-align: center;
}

.local-banner {
  padding: 20rpx 24rpx;
  border: 1rpx solid #bfd4ff;
  border-radius: 16rpx;
  background-color: #eaf0ff;
  color: #2454b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.outdated-banner {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #e5a534;
  border-radius: 12rpx;
  background-color: #fff7e6;
  color: #8a5700;
  font-size: 24rpx;
  line-height: 1.8;
}

.point-summary {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.origin-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.origin-ai {
  background-color: #eef2ff;
  color: #4f46e5;
}

.origin-user-edited {
  background-color: #fff7e6;
  color: #8a5700;
}

.origin-user-created {
  background-color: #eaf8ee;
  color: #166534;
}

.add-category-button {
  margin-top: 28rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
  color: #2454b8;
  border: 1rpx solid #bfd4ff;
  font-size: 28rpx;
  line-height: 1.5;
}