page {
  background-color: #f5f7fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.knowledge-page {
  padding: 28rpx 32rpx 48rpx;
}

button::after {
  border: none;
}

.demo-banner {
  padding: 20rpx 24rpx;
  border: 1rpx solid #ffe0a3;
  border-radius: 16rpx;
  background-color: #fff7e6;
  color: #8a5700;
  font-size: 24rpx;
  line-height: 1.6;
}

.heading {
  margin: 32rpx 0 26rpx;
}

.point-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.5;
}

.category {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.6;
}

.content-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 18rpx;
  background-color: #ffffff;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
}

.body-text {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.9;
  word-break: break-word;
}

.review-notice {
  padding: 24rpx;
  border-left: 6rpx solid #e5a534;
  border-radius: 12rpx;
  background-color: #fff7e6;
}

.notice-title {
  display: block;
  color: #8a5700;
  font-size: 27rpx;
  font-weight: 600;
}

.notice-text {
  display: block;
  margin-top: 10rpx;
  color: #805e27;
  font-size: 25rpx;
  line-height: 1.8;
}

.expand-button,
.edit-button {
  width: 100%;
  box-sizing: border-box;
  margin: 24rpx 0;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.expand-button {
  background-color: #eaf0ff;
  color: #2454b8;
}

.edit-button {
  background-color: #2563eb;
  color: #ffffff;
}

.sub-title {
  display: block;
  margin-top: 26rpx;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.section-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.supplement-tag {
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: #eaf0ff;
  color: #2454b8;
  font-size: 21rpx;
}

.small-note {
  display: block;
  margin-top: 16rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.8;
}

.code-scroll {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background-color: #172033;
}

.code-inner {
  display: inline-block;
  min-width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.code-text {
  color: #e2e8f0;
  font-family: Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.9;
  white-space: pre;
}

.correction-card {
  border-color: #f1d6a0;
}

.quote-box {
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  background-color: #f1f5f9;
}

.quote-text {
  font-family: Consolas, monospace;
  font-size: 25rpx;
  line-height: 1.8;
  word-break: break-all;
}

.source-button {
  width: 100%;
  margin: 20rpx 0 0;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background-color: #f1f5f9;
  color: #2563eb;
  font-size: 26rpx;
  line-height: 1.5;
}

.footer-note {
  display: block;
  color: #8491a3;
  font-size: 23rpx;
  line-height: 1.7;
  text-align: center;
}

.unavailable {
  margin-top: 28rpx;
}


.storage-notice {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.editor-card {
  margin-top: 24rpx;
  border-color: #a9c5ff;
}

.field-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 27rpx;
  font-weight: 600;
}

.editor-input {
  display: block;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background-color: #f8fafc;
  color: #1f2937;
  font-size: 27rpx;
  line-height: 1.7;
}

.summary-input {
  height: 240rpx;
}

.explanation-input {
  height: 360rpx;
}

.character-count {
  display: block;
  margin-top: 8rpx;
  color: #8491a3;
  font-size: 22rpx;
  text-align: right;
}

.editor-actions {
  display: flex;
  margin-top: 28rpx;
}

.cancel-button,
.save-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 20rpx 10rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.cancel-button {
  background-color: #f1f5f9;
  color: #475569;
}

.save-button {
  margin-left: 16rpx;
  background-color: #2563eb;
  color: #ffffff;
}

.modified-notice {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #eaf0ff;
  color: #2454b8;
  font-size: 24rpx;
  line-height: 1.8;
}

.local-ai-banner {
  padding: 20rpx 24rpx;
  border: 1rpx solid #bfd4ff;
  border-radius: 16rpx;
  background-color: #eaf0ff;
  color: #2454b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.outdated-notice {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #e5a534;
  border-radius: 12rpx;
  background-color: #fff7e6;
  color: #8a5700;
  font-size: 24rpx;
  line-height: 1.8;
}

.source-box {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #f1f5f9;
}

.source-id {
  display: block;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.source-text {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.user-modified-notice {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background-color: #eaf0ff;
  color: #2454b8;
  font-size: 24rpx;
  line-height: 1.8;
}

.edit-card {
  margin-top: 24rpx;
  border-color: #a9c5ff;
}

.field-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.knowledge-input,
.knowledge-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  background-color: #f8fafc;
  color: #1f2937;
  font-size: 27rpx;
}

.knowledge-input {
  height: 90rpx;
  padding: 0 20rpx;
}

.knowledge-textarea {
  height: 300rpx;
  padding: 20rpx;
  line-height: 1.8;
}

.edit-warning {
  display: block;
  margin-top: 18rpx;
  color: #8a5700;
  font-size: 23rpx;
  line-height: 1.7;
}

.edit-actions {
  display: flex;
  margin-top: 24rpx;
}

.cancel-edit-button,
.save-edit-button {
  flex: 1;
  margin: 0;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.cancel-edit-button {
  background-color: #f1f5f9;
  color: #475569;
}

.save-edit-button {
  margin-left: 16rpx;
  background-color: #2563eb;
  color: #ffffff;
}

.delete-point-button {
  width: 100%;
  box-sizing: border-box;
  margin: 16rpx 0 24rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid #fecaca;
  border-radius: 14rpx;
  background-color: #fff1f2;
  color: #b42318;
  font-size: 27rpx;
  line-height: 1.5;
}

.move-category-button {
  width: 100%;
  box-sizing: border-box;
  margin: 16rpx 0;
  padding: 20rpx 16rpx;
  border-radius: 14rpx;
  background-color: #f1f5f9;
  color: #334155;
  font-size: 27rpx;
  line-height: 1.5;
}